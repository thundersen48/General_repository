# coding: utf-8
import numpy as np
import matplotlib.pyplot as plt


def rotation_matrix(theta_deg):
    """Матрица поворота на угол в градусах"""

    theta = np.radians(theta_deg)
    return np.array([
        [np.cos(theta), -np.sin(theta), 0],
        [np.sin(theta), np.cos(theta), 0],
        [0, 0, 1]
    ])

"""Матрица сдвига """
def translation_matrix(dx, dy):
    return np.array([
        [1, 0, dx],
        [0, 1, dy],
        [0, 0, 1]
    ])


def L_transform(theta_deg, length):
    """
    Матрица преобразования для одного звена
    сначала сдвиг на length вдоль своей оси X,
    потом поворот на theta_deg.
    """
    T = translation_matrix(length, 0) # Свдиг вдоль локальной x
    R = rotation_matrix(theta_deg)
    return R @ T  #сначала сдвиг, потом поворот


def base_transform(base_x, base_y, base_angle):
    """
    Матрица преобразования базовой СК:
    сначала поворот на base_angle, затем сдвиг на (base_x, base_y)
    """
    R_base = rotation_matrix(base_angle)
    T_base = translation_matrix(base_x, base_y)
    return T_base @ R_base


def forward_kinematics(l1, l2, l3, theta1, theta2, theta3, base_x = 0, base_y = 0, base_angle = 0):
    """
    Прямая кинематика манипулятора с  базой
    Возвращает координаты всех точек в глобальной СК:
    основание, звено1, Звено2, раб.орган
    """
    # Матрица базы
    T_base = base_transform(base_x, base_y, base_angle)
    # Матрицы звеньев
    A1 = L_transform(theta1, l1)
    A2 = L_transform(theta2, l2)
    A3 = L_transform(theta3, l3)

    # Общие преобразования от базы к раб органу
    T1 = T_base @ A1
    T2 = T1 @ A2
    T3 = T2 @ A3
    # Точка основания в базовой СК: [0, 0, 1]
    base_point_local = np.array([0, 0, 1])

    # Преобразуем все точки в глобальную СК умножив на вектор
    base_global = T_base @ base_point_local
    L1_global = T1 @ base_point_local
    L2_global = T2 @ base_point_local
    L3_global = T3 @ base_point_local

    # Извлекаем координаты x, y убирая 0
    points = np.array([
        base_global[:2],  # основание (в глобальной СК)
        L1_global[:2],  # Звено 1
        L2_global[:2],  # Звено 2
        L3_global[:2]  # Звено 3
    ])

    return points


def plot_manipulator(points, base_x = 0, base_y = 0):
    """ Столбцы x and y из м-цы координат 4X2"""
    x_coords = points[:, 0] #Столбец x
    y_coords = points[:, 1] #Столбец y

    plt.figure(figsize=(8, 8))
    plt.plot(x_coords, y_coords, 'o-', linewidth= 7, markersize= 10, color='darkorange')



    plt.plot(0, 0, 'ro', markersize=8, label='Глобальная ск (0,0)')

    plt.plot(base_x, base_y, 'go', markersize=8, label='Base')


    plt.grid(True)
    plt.axis('equal')
    plt.title('Kuka')
    plt.xlabel('X')
    plt.ylabel('Y')
    plt.legend()
    plt.show()

    # Вывод координат
    labels = ['Основание', 'Звено 1', 'Звено 2', 'Раб. Орган']
    for label, (x, y) in zip(labels, points):
        print(f"{label}: ({x:.3f}, {y:.3f})")



""" Длины звеньев """
l1 = 5
l2 = 3
l3 = 2

""" Углы в градусах """
theta1 = 60
theta2 = -45
theta3 = -85

""" Параметры базы """
base_x = 0
base_y = 0
base_angle = 15  #в градусах

points = forward_kinematics(l1, l2, l3,theta1, theta2, theta3, base_x = base_x, base_y = base_y, base_angle = base_angle)

plot_manipulator(points, base_x = base_x, base_y = base_y)
